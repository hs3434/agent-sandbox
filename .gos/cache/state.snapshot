  "review_findings": [
    {
      "severity": "major",
      "issue": "killProcFamily race: registry pop+CloseHandle outside lookup lock allowed concurrent double-kill double-close",
      "status": "fixed",
      "fix": "pop+close under one lock; loser falls to harmless pid fallback"
    },
    {
      "severity": "minor",
      "issue": "pidAlive no-job fallback can false-positive on recycled pid (windows pid reuse)",
      "status": "accepted-debt",
      "fix": "documented; job registry is primary truth; pidfd endgame follow-up"
    },
    {
      "severity": "minor",
      "issue": "handshake ack written via json.NewEncoder without WriteMessage framing check",
      "status": "accepted",
      "fix": "read path enforces the 32MB limit; write is daemon-marshalled small object"
    }
  ]
