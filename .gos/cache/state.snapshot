  "decisions": [
    {
      "id": "D-31",
      "title": "companion transport: daemon binds 127.0.0.1 auto port in conn.json; sandboxd bridges via ssh -W TCP forward",
      "rationale": "Loopback+ssh -W keeps auth on ssh+token (D-16), port kernel-assigned. Unix socket forced nc -U bridge, absent on Windows. L4 decoupling kept; nc dep removed.",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
      "covered": false,
      "covered_by": null
    },
    {
      "id": "D-32",
      "title": "windows process model: Job Objects + Git Bash sh",
      "rationale": "Job Object is the kernel twin of the process group: kill tree, orphan guard, live probe. Wrapper shell: Git Bash sh.exe. Split = 4 funcs behind build tags.",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
