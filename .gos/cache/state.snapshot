    },
    {
      "id": "D-02",
      "title": "vscode lifecycle: version handshake/auto-reinstall pin/single connection+events/discovery/reattach/idle TTL/GC",
      "rationale": "Chosen over build our own lifecycle / adopt vscode semantics verbatim \u2014 why-not: proven mechanics; commit-pin becomes proto_version handshake",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
      "covered": false,
      "covered_by": null
    },
    {
      "id": "D-03",
      "title": "Docker axis does NOT deploy companion; unify contract vocabulary not deployments",
      "rationale": "Chosen over companion for both axes / daemon-as-companion for docker \u2014 why-not: zero-value hop; daemon already resident peer with process registry+events",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
      "covered": false,
      "covered_by": null
    },
    {
      "id": "D-04",
      "title": "workdir: fence -> safe-box; invariant unchanged, role = durability guarantee only",
      "rationale": "Chosen over keep fence / keep invariant, drop permission semantics \u2014 why-not: agent freedom; bind-mount translation stays as fast-path basis",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
      "covered": false,
      "covered_by": null
    },
    {
      "id": "D-05",
      "title": "pid truth: handoff capture + starttime identity + pidfd endgame; exit code via wrapper file",
      "rationale": "Chosen over trust pid blindly / handoff+starttime+pidfd \u2014 why-not: pid reuse breaks kill -0; wrong-kill is the worst outcome",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
      "covered": false,
      "covered_by": null
    },
    {
      "id": "D-06",
      "title": "One supervisor loop + machine process table; batch probe O(1); restart reconciliation",
      "rationale": "Chosen over observer per handle / single supervisor \u2014 why-not: per-handle observers amplify on ssh; table feeds L5 reattach",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
      "covered": false,
      "covered_by": null
    },
    {
