    {
      "id": "D-01",
      "title": "Name sandboxd-server; files via protocol; SFTP demoted to bootstrap; thin fallback",
      "rationale": "Chosen over stdio on ssh channel / unix socket+direct-tcpip \u2014 why-not: L4 would die with connection \u2014 tunnel in JSON, not protocol dialogue",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
      "covered": false,
