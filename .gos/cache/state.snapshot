      "title": "Large files: whole-file base64 + 10MB cap; streaming deferred",
      "rationale": "Chosen over chunked streaming now / cap+defer \u2014 why-not: agent files are configs/code; YAGNI",
      "birth_phase": "P0",
      "status": "open",
      "anchor": null,
